<Window x:Class="DetsadSklad.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI" FontSize="15" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,22,24,20">
        <DockPanel>
            <Image Source="pack://application:,,,/Assets/app.ico" Width="48" Height="48" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Детсад-Склад" Style="{StaticResource SectionTitle}" FontSize="21"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Автор" Style="{StaticResource FieldLabel}" Margin="0,20,0,2"/>
        <TextBlock Text="Карчевский Николай" TextWrapping="Wrap"/>

        <TextBlock Text="Электронная почта" Style="{StaticResource FieldLabel}" Margin="0,14,0,2"/>
        <TextBlock>
            <Hyperlink NavigateUri="mailto:nikar.tom@gmail.com" RequestNavigate="OnLinkClick">nikar.tom@gmail.com</Hyperlink>
        </TextBlock>

        <TextBlock Text="Новые версии программы" Style="{StaticResource FieldLabel}" Margin="0,14,0,2"/>
        <TextBlock TextWrapping="Wrap">
            <Hyperlink NavigateUri="https://github.com/nikartom/detsadsklad" RequestNavigate="OnLinkClick">https://github.com/nikartom/detsadsklad</Hyperlink>
        </TextBlock>

        <Button Style="{StaticResource SecondaryButton}" Content="Закрыть" MinWidth="110" HorizontalAlignment="Right" Margin="0,22,0,0" IsCancel="True" IsDefault="True"/>
    </StackPanel>
</Window>
