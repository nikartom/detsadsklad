<UserControl x:Class="DetsadSklad.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DetsadSklad.Controls">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Детский сад" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Название"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding NameHasError}" AutomationProperties.Name="Название"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес" Margin="0,12,0,5"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding AddressHasError}" AutomationProperties.Name="Адрес"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Электронная почта" Margin="0,12,0,5"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Электронная почта"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес поставки товара" Margin="0,12,0,5"/>
                        <TextBox Style="{StaticResource MultilineBox}" Height="66" Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ui:Ui.HasError="{Binding DeliveryAddressHasError}" AutomationProperties.Name="Адрес поставки товара"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Время поставки (подставляется в новые заявки)" Margin="0,12,0,5"/>
                        <TextBox Text="{Binding DeliveryTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Время поставки"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="Сотрудники" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Кто работает с программой"/>
                            <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="Фамилия, имя, отчество" AutomationProperties.Name="Кто работает с программой"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="От кого документы (подпись «Заказчик»)" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding SignerName, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding SignerNameHasError}"
                                     ui:Ui.Hint="Например: И.И. Иванова" AutomationProperties.Name="От кого документы"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Документ" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <CheckBox IsChecked="{Binding Highlight}">
                                <TextBlock Text="Выделять красным номер заявки, контракт и даты, как в образце" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Где хранятся данные" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding DataFolderText}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <TextBlock Text="Резервная копия делается сама, раз в день." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Открыть папку" ui:Ui.Icon="{StaticResource IconFolder}" Command="{Binding OpenDataFolderCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" MinWidth="140" ui:Ui.Icon="{StaticResource IconCheck}" Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding SavedNote}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryHoverBrush}" FontWeight="SemiBold"/>
            <Border Style="{StaticResource ErrorBanner}" Margin="12,0,0,0" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
