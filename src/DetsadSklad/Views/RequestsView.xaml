<UserControl x:Class="DetsadSklad.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DetsadSklad.Controls">
    <Grid>
        <!-- Список заявок -->
        <Grid Margin="24,20,24,20" Visibility="{Binding IsListVisible, Converter={StaticResource BoolToCollapsed}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Новая заявка" MinHeight="46" FontSize="16"
                        ui:Ui.Icon="{StaticResource IconPlus}" Command="{Binding NewRequestCommand}"/>
                <TextBlock Text="Заявки" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Поиск и фильтры -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Padding="36,0,10,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ui:Ui.Hint="Поиск: номер, продукт, поставщик…" AutomationProperties.Name="Поиск заявок"/>
                    <ui:Icon Width="19" Height="19" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"
                             Foreground="{StaticResource MutedBrush}" Data="{StaticResource IconSearch}"/>
                </Grid>
                <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding SupplierOptions}" SelectedItem="{Binding SupplierFilter}"
                          AutomationProperties.Name="Поставщик"/>
                <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding ContractOptions}" SelectedItem="{Binding ContractFilter}"
                          IsEnabled="{Binding CanFilterByContract}" AutomationProperties.Name="Контракт"/>
                <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding PeriodFilter}"
                          AutomationProperties.Name="Период"/>
                <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource GhostButton}" MinHeight="40" Content="Показать все"
                        Command="{Binding ClearFiltersCommand}"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="20,11,32,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="№"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Поставщик и контракт"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Отправлена"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Поставка"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Сумма" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Список заявок">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Нажали на заявку — она открылась на месте списка -->
                                    <Button Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding TitleText}"
                                            Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource DisabledBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold" FontSize="16"/>
                                                        <TextBlock Grid.Column="1" Margin="0,0,12,0" TextWrapping="Wrap">
                                                            <Run Text="{Binding Supplier, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="  —  " Foreground="{StaticResource MutedBrush}"/>
                                                            <Run Text="{Binding ContractText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Text="{Binding SentText}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding DeliveryText}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding TotalText}" HorizontalAlignment="Right" TextAlignment="Right" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="{Binding EmptyText}" FontSize="16" TextAlignment="Center"
                               Margin="40" VerticalAlignment="Center" Visibility="{Binding HasRows, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}"/>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,9"
                            Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Заявка открыта: на месте списка -->
        <Grid Margin="24,16,24,16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToCollapsed}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <!-- Дополнительные действия — справа от заголовка -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Печать" Margin="8,0,0,0" ui:Ui.Icon="{StaticResource IconPrint}" Command="{Binding PrintCommand}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Повторить" Margin="8,0,0,0" ui:Ui.Icon="{StaticResource IconCopy}"
                            Command="{Binding RepeatCommand}" ToolTip="Новая заявка с теми же продуктами и количеством"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="На флешку" Margin="8,0,0,0" ui:Ui.Icon="{StaticResource IconDownload}"
                            Command="{Binding SaveAsCommand}" ToolTip="Сохранить файл заявки в другое место, например на флешку"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="В папке" Margin="8,0,0,0" ui:Ui.Icon="{StaticResource IconFolder}"
                            Command="{Binding ShowInFolderCommand}" ToolTip="Показать файл заявки в папке — например, чтобы прикрепить к письму"/>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="К списку заявок" ui:Ui.Icon="{StaticResource IconBack}" Margin="-10,0,14,0"
                        Command="{Binding BackCommand}"/>
                <TextBlock Text="{Binding Selected.TitleText}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="22,18,22,18" DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding Supplier}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ContractText}" Style="{StaticResource Muted}" FontSize="15" Margin="0,2,0,0"/>
                        <TextBlock FontSize="15" Margin="0,10,0,0">
                            <Run Text="Отправлена:" Foreground="{StaticResource MutedBrush}"/> <Run Text="{Binding SentText, Mode=OneWay}"/>
                            <Run Text="      Поставка:" Foreground="{StaticResource MutedBrush}"/> <Run Text="{Binding DeliveryText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                            <Run Text="{Binding SignerText, Mode=OneWay}"/>
                            <Run Text="{Binding CreatedByText, Mode=OneWay}"/>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,16,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DisabledBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Details}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding TotalText}" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="18"/>
                                <TextBlock Text="Итого" FontWeight="SemiBold" FontSize="18"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Style="{StaticResource DangerButton}" Content="Удалить" ui:Ui.Icon="{StaticResource IconTrash}" Command="{Binding DeleteCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Изменить" MinWidth="140" MinHeight="46" ui:Ui.Icon="{StaticResource IconEdit}" Command="{Binding EditCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Открыть в Word" MinHeight="46" FontSize="16" Margin="10,0,0,0" ui:Ui.Icon="{StaticResource IconOpen}" Command="{Binding OpenCommand}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
