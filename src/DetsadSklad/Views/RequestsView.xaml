<UserControl x:Class="DetsadSklad.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DetsadSklad.Controls">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Новая заявка" MinHeight="46" FontSize="16"
                    ui:Ui.Icon="{StaticResource IconPlus}" Command="{Binding NewRequestCommand}"/>
            <TextBlock Text="Заявки" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Поиск и фильтры -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Padding="36,0,10,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ui:Ui.Hint="Поиск: номер, продукт, поставщик…" AutomationProperties.Name="Поиск заявок"/>
                <ui:Icon Width="19" Height="19" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"
                         Foreground="{StaticResource MutedBrush}" Data="{StaticResource IconSearch}"/>
            </Grid>
            <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding SupplierOptions}" SelectedItem="{Binding SupplierFilter}"
                      AutomationProperties.Name="Поставщик"/>
            <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding ContractOptions}" SelectedItem="{Binding ContractFilter}"
                      IsEnabled="{Binding CanFilterByContract}" AutomationProperties.Name="Контракт"/>
            <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding PeriodFilter}"
                      AutomationProperties.Name="Период"/>
            <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource GhostButton}" MinHeight="40" Content="Показать все"
                    Command="{Binding ClearFiltersCommand}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="292" MaxWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Список -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,11,26,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="№"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Поставщик и контракт"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Отправлена"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Поставка"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Сумма" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                             MouseDoubleClick="OnRowDoubleClick" AutomationProperties.Name="Список заявок">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold" FontSize="16"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Supplier}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ContractText}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SentText}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DeliveryText}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="{Binding EmptyText}" FontSize="16" TextAlignment="Center"
                               Margin="40" VerticalAlignment="Center" Visibility="{Binding HasRows, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}"/>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,9"
                            Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Выбранная заявка -->
            <Border Grid.Column="2" Style="{StaticResource Card}"
                    Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                <Grid DataContext="{Binding Selected}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                        <StackPanel Margin="18,16,16,10">
                            <TextBlock Text="{Binding TitleText}" Style="{StaticResource SectionTitle}" FontSize="21"/>
                            <TextBlock Text="{Binding Supplier}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding ContractText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0">
                                <Run Text="Отправлена:"/> <Run Text="{Binding SentText, Mode=OneWay}"/>
                                <LineBreak/>
                                <Run Text="Поставка:"/> <Run Text="{Binding DeliveryText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding SignerText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding CreatedByText}" Style="{StaticResource Muted}"
                                       Visibility="{Binding CreatedByText, Converter={StaticResource NullToCollapsed}}"/>
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,12,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DisabledBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding TotalText}" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Итого" FontWeight="SemiBold" FontSize="16"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="Открыть в Word" ui:Ui.Icon="{StaticResource IconOpen}" Command="{Binding OpenCommand}"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Печать" Margin="0,0,4,0" Padding="6,0" ui:Ui.Icon="{StaticResource IconPrint}" Command="{Binding PrintCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Сохранить" Margin="4,0,0,0" Padding="6,0" ui:Ui.Icon="{StaticResource IconDownload}"
                                        Command="{Binding SaveAsCommand}" ToolTip="Сохранить файл заявки в другое место, например на флешку"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Изменить" Margin="0,8,4,0" Padding="6,0" ui:Ui.Icon="{StaticResource IconEdit}" Command="{Binding EditCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Повторить" Margin="4,8,0,0" Padding="6,0" ui:Ui.Icon="{StaticResource IconCopy}"
                                        Command="{Binding RepeatCommand}" ToolTip="Новая заявка с теми же продуктами и количеством"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="В папке" Margin="0,8,4,0" Padding="6,0" ui:Ui.Icon="{StaticResource IconFolder}"
                                        Command="{Binding ShowInFolderCommand}" ToolTip="Показать файл заявки в папке — например, чтобы прикрепить к письму"/>
                                <Button Style="{StaticResource DangerButton}" Content="Удалить" Margin="4,8,0,0" Padding="6,0" ui:Ui.Icon="{StaticResource IconTrash}" Command="{Binding DeleteCommand}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
