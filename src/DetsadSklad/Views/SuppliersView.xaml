<UserControl x:Class="DetsadSklad.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DetsadSklad.Controls">
    <Grid>
        <!-- Список поставщиков -->
        <Grid Margin="24,20,24,20" Visibility="{Binding IsListVisible, Converter={StaticResource BoolToCollapsed}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Новый поставщик" MinHeight="46" FontSize="16"
                        ui:Ui.Icon="{StaticResource IconPlus}" Command="{Binding AddCommand}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Загрузить контракт из файла" MinHeight="46" FontSize="16" Margin="0,0,10,0"
                        ui:Ui.Icon="{StaticResource IconDownload}" Command="{Binding ImportCommand}"
                        ToolTip="Выберите PDF контракта — поставщик, контракт и продукты заполнятся сами. Сейчас поддерживаются контракты площадки КУЗБАСС TRADE"/>
                <TextBlock Text="Поставщики" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Список поставщиков">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource DisabledBrush}" BorderThickness="0,0,0,1" Padding="20,15">
                                                    <!-- Всё в одну строку: название — 2 контракта: Бакалея, Заморозка -->
                                                    <TextBlock TextWrapping="Wrap" FontSize="17">
                                                        <Run x:Name="NameText" Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="  —  " Foreground="{StaticResource MutedBrush}"/>
                                                        <Run Text="{Binding SuppliesText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                        <Run x:Name="InactiveNote" Text="" Foreground="{StaticResource WarnBrush}"/>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Setter TargetName="InactiveNote" Property="Text" Value="  (не работаем)"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource Muted}" FontSize="16" TextAlignment="Center" Margin="24" VerticalAlignment="Center"
                               Text="Поставщиков пока нет. Нажмите «Новый поставщик»."
                               Visibility="{Binding HasRows, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Поставщик открыт: на месте списка -->
        <Grid Margin="24,16,24,16" Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <Button Style="{StaticResource GhostButton}" Content="К списку поставщиков" ui:Ui.Icon="{StaticResource IconBack}" Margin="-10,0,14,0"
                        Command="{Binding CancelCommand}"/>
                <TextBlock Text="{Binding Editor.Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Border x:Name="EditorRoot" Grid.Row="1" Style="{StaticResource Card}" DataContext="{Binding Editor}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="22,18,20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Короткое название"/>
                                <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding ShortNameHasError}"
                                         ui:Ui.Hint="ООО &quot;Название&quot;" AutomationProperties.Name="Короткое название"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Эл. почта"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Электронная почта"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Телефон"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Телефон"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Полное наименование (как в документе)" Margin="0,12,0,5"/>
                        <TextBox Style="{StaticResource MultilineBox}" Height="58" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 ui:Ui.HasError="{Binding FullNameHasError}" AutomationProperties.Name="Полное наименование"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес" Margin="0,12,0,5"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding AddressHasError}" AutomationProperties.Name="Адрес"/>

                        <CheckBox IsChecked="{Binding IsActive}" Margin="0,12,0,0">
                            <TextBlock Text="Работаем с этим поставщиком (предлагать в новых заявках)" TextWrapping="Wrap"/>
                        </CheckBox>

                        <DockPanel Margin="0,24,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Добавить контракт" MinHeight="40" VerticalAlignment="Center" Margin="8,0,0,0"
                                    ui:Ui.Icon="{StaticResource IconPlus}" Command="{Binding AddContractCommand}"/>
                            <TextBlock Text="Действующие контракты" Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,5" Visibility="{Binding HasContracts, Converter={StaticResource BoolToCollapsed}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="Что поставляет"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Номер контракта" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Заключён" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Действует по" Margin="8,0,0,0"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Contracts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="Например: бакалея" AutomationProperties.Name="Что поставляет"/>
                                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding NumberHasError}"
                                                 ui:Ui.Hint="Номер из договора" ui:Ui.FocusWhen="{Binding FocusNumber, Mode=TwoWay}" AutomationProperties.Name="Номер контракта"/>
                                        <DatePicker Grid.Column="2" Margin="8,0,0,0" SelectedDate="{Binding SignedOn}" ui:Ui.HasError="{Binding SignedOnHasError}" AutomationProperties.Name="Заключён"/>
                                        <DatePicker Grid.Column="3" Margin="8,0,0,0" SelectedDate="{Binding ValidTo}" ui:Ui.HasError="{Binding ValidToHasError}" AutomationProperties.Name="Действует по"/>
                                        <Button Grid.Column="4" Style="{StaticResource IconButton}" HorizontalAlignment="Right" ui:Ui.Icon="{StaticResource IconClose}"
                                                ToolTip="Убрать контракт" AutomationProperties.Name="Убрать контракт"
                                                Command="{Binding DataContext.RemoveContractCommand, ElementName=EditorRoot}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Действующих контрактов нет. Нажмите «Добавить контракт» или «Продлить» ниже." Style="{StaticResource Muted}" FontSize="15"
                                   Visibility="{Binding HasContracts, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}"/>

                        <!-- Срок закончился: одна кнопка «Продлить» -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding HasFinishedContracts, Converter={StaticResource BoolToCollapsed}}">
                            <TextBlock Text="Срок закончился" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding FinishedContracts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="7" Padding="14,9" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Продлить" MinWidth="130" MinHeight="40"
                                                        ToolTip="Добавить этот контракт на новый срок: впишите новый номер и дату. Продукты останутся прежними."
                                                        Command="{Binding DataContext.RenewContractCommand, ElementName=EditorRoot}" CommandParameter="{Binding}"/>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,10" Visibility="{Binding Editor.Error, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Editor.Error}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                </Border>
                <DockPanel>
                    <Button Style="{StaticResource DangerButton}" Content="Удалить поставщика" ui:Ui.Icon="{StaticResource IconTrash}" Command="{Binding DeleteCommand}"
                            Visibility="{Binding Editor.IsNew, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Отмена" MinWidth="120" MinHeight="46" Command="{Binding CancelCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" MinWidth="150" MinHeight="46" FontSize="16" Margin="10,0,0,0"
                                ui:Ui.Icon="{StaticResource IconCheck}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- Загрузка контракта из файла: что нашлось, проверить и сохранить -->
        <Grid Margin="24,16,24,16" Visibility="{Binding IsImporting, Converter={StaticResource BoolToCollapsed}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <Button Style="{StaticResource GhostButton}" Content="К списку поставщиков" ui:Ui.Icon="{StaticResource IconBack}" Margin="-10,0,14,0"
                        Command="{Binding CancelCommand}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Загрузка контракта" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding Import.SourceText}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" DataContext="{Binding Import}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="22,18,20,18">
                        <TextBlock Text="Проверьте, всё ли верно, и нажмите «Сохранить»." FontSize="16" Margin="0,0,0,14"/>

                        <TextBlock Text="Поставщик" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource WarnBanner}" Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                                Visibility="{Binding IsKnownSupplier, Converter={StaticResource BoolToCollapsed}}">
                            <TextBlock Text="{Binding KnownSupplierText}" TextWrapping="Wrap" FontSize="15"/>
                        </Border>
                        <StackPanel Visibility="{Binding IsNewSupplier, Converter={StaticResource BoolToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Короткое название"/>
                                    <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Короткое название"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Эл. почта"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Электронная почта"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Телефон"/>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Телефон"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Полное наименование (как в документе)" Margin="0,12,0,5"/>
                            <TextBox Style="{StaticResource MultilineBox}" Height="58" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Полное наименование"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Адрес"/>
                        </StackPanel>

                        <TextBlock Text="Контракт" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,22,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Что поставляет"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Что поставляет"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Номер контракта"/>
                                <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Номер контракта"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Заключён"/>
                                <DatePicker SelectedDate="{Binding SignedOn}" AutomationProperties.Name="Заключён"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Действует по"/>
                                <DatePicker SelectedDate="{Binding ValidTo}" AutomationProperties.Name="Действует по"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Visibility="{Binding PeriodText, Converter={StaticResource NullToCollapsed}}"/>

                        <TextBlock Text="{Binding ItemsTitle}" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,22,0,8"/>
                        <Border Style="{StaticResource WarnBanner}" Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource PrimaryBrush}" Margin="0,0,0,10"
                                Visibility="{Binding IsComplete, Converter={StaticResource BoolToCollapsed}}">
                            <DockPanel>
                                <ui:Icon Width="20" Height="20" Foreground="{StaticResource PrimaryBrush}" Data="{StaticResource IconCheck}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CheckText}" TextWrapping="Wrap" FontSize="15"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,10" Visibility="{Binding IsComplete, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}">
                            <TextBlock Text="{Binding CheckText}" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource WarnBrush}"/>
                        </Border>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="№"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Наименование (как в контракте)"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Ед." Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Цена, руб." HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="В программе" Margin="16,0,0,0"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DisabledBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Position}" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" FontSize="14"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Unit}" TextWrapping="Wrap" FontSize="14" Margin="12,0,0,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PriceText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="Status" Grid.Column="4" Text="{Binding StatusText}" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="Status" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            <Setter TargetName="Status" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Продукты той же группы, которых в новом контракте нет -->
                        <StackPanel Margin="0,20,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToCollapsed}}">
                            <TextBlock Text="{Binding MissingTitle}" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Эти продукты есть в программе, но в этом контракте их нет — например, изменилось описание. Они останутся. Если больше не нужны, удалите их в разделе «Продукты»."/>
                            <ItemsControl ItemsSource="{Binding Missing}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DisabledBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource WarnBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,10" Visibility="{Binding Import.Error, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Import.Error}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Отмена" MinWidth="120" MinHeight="46" Command="{Binding CancelCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" MinWidth="150" MinHeight="46" FontSize="16" Margin="10,0,0,0"
                            ui:Ui.Icon="{StaticResource IconCheck}" Command="{Binding SaveImportCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
