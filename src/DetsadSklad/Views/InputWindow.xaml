<Window x:Class="DetsadSklad.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DetsadSklad.Controls"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI" FontSize="15" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=ValueBox}">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <TextBox x:Name="ValueBox" AutomationProperties.Name="Название" TextChanged="OnTextChanged"/>
        <TextBlock x:Name="ErrorText" Text="Напишите название или нажмите «Отмена»." Foreground="{StaticResource DangerBrush}"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Отмена" MinWidth="100" IsCancel="True"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Добавить" MinWidth="110" Margin="10,0,0,0" IsDefault="True" Click="OnAdd"/>
        </StackPanel>
    </StackPanel>
</Window>
