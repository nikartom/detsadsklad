<UserControl x:Class="DetsadSklad.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DetsadSklad.Controls">
    <UserControl.Resources>
        <Style x:Key="SmallBanner" TargetType="Border" BasedOn="{StaticResource WarnBanner}">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <Button Style="{StaticResource GhostButton}" Content="К списку заявок" ui:Ui.Icon="{StaticResource IconBack}" Margin="-10,0,14,0"
                    Command="{Binding BackCommand}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Кому и когда -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Поставщик"/>
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="ShortName"
                                  ui:Ui.HasError="{Binding SupplierHasError}" AutomationProperties.Name="Поставщик"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Контракт"/>
                        <ComboBox ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}" DisplayMemberPath="DisplayName"
                                  ui:Ui.HasError="{Binding ContractHasError}" AutomationProperties.Name="Контракт"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Номер заявки"/>
                        <TextBox Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" ui:Ui.HasError="{Binding NumberHasError}"
                                 AutomationProperties.Name="Номер заявки"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Дата поставки"/>
                        <DatePicker SelectedDate="{Binding DeliveryDate}" ui:Ui.HasError="{Binding DeliveryDateHasError}" AutomationProperties.Name="Дата поставки"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Время поставки"/>
                        <TextBox Text="{Binding DeliveryTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Время поставки"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Дата направления"/>
                        <DatePicker SelectedDate="{Binding SentDate}" ui:Ui.HasError="{Binding SentDateHasError}" AutomationProperties.Name="Дата направления"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SmallBanner}" Visibility="{Binding NoContractsNote, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding NoContractsNote}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"/>
                </Border>
                <Border Style="{StaticResource SmallBanner}" Visibility="{Binding ContractWarning, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ContractWarning}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"/>
                </Border>
                <Border Style="{StaticResource SmallBanner}" Visibility="{Binding DateWarning, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding DateWarning}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"/>
                </Border>
                <Border Style="{StaticResource SmallBanner}" Visibility="{Binding RequisitesNote, Converter={StaticResource NullToCollapsed}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" MinHeight="36" Margin="12,0,0,0" Content="Обновить реквизиты"
                                ui:Ui.Icon="{StaticResource IconRefresh}" Command="{Binding RefreshRequisitesCommand}"/>
                        <TextBlock Text="{Binding RequisitesNote}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Что заказываем -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="290"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="14,10,26,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*" MinWidth="110"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="№"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Продукт"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Ед."/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Количество"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Цена, руб."/>
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="Сумма" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="14,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DisabledBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*" MinWidth="110"/>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Position}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Description}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Details}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Margin="0,0,6,0" MaxHeight="52" ToolTip="{Binding Unit}"/>
                                            <TextBox Grid.Column="3" Margin="0,0,8,0" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                     ui:Ui.HasError="{Binding QuantityHasError}" ui:Ui.FocusWhen="{Binding FocusQuantity, Mode=TwoWay}"
                                                     AutomationProperties.Name="Количество"/>
                                            <TextBox Grid.Column="4" Margin="0,0,8,0" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                     ui:Ui.HasError="{Binding PriceHasError}" AutomationProperties.Name="Цена"/>
                                            <TextBlock Grid.Column="5" Text="{Binding CostText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            <Button Grid.Column="6" Style="{StaticResource IconButton}" HorizontalAlignment="Right" ui:Ui.Icon="{StaticResource IconClose}"
                                                    ToolTip="Убрать из заявки" AutomationProperties.Name="Убрать из заявки"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40"
                                Visibility="{Binding HasLines, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}">
                        <TextBlock Text="Заявка пока пустая" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="15" Margin="0,4,0,0" TextAlignment="Center"
                                   Text="Нажмите на продукт в списке справа — он появится здесь, останется указать количество."/>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Итого:" FontSize="17" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding TotalText}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Каталог -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,12,12,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Добавить продукт"/>
                        <Grid>
                            <TextBox Padding="34,0,8,0" Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Hint="Поиск продукта"
                                     AutomationProperties.Name="Поиск продукта"/>
                            <ui:Icon Width="18" Height="18" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"
                                     Foreground="{StaticResource MutedBrush}" Data="{StaticResource IconSearch}"/>
                        </Grid>
                        <CheckBox Content="Всех поставщиков" IsChecked="{Binding ShowAllProducts}" Margin="0,9,0,0"
                                  ToolTip="Показать продукты, закреплённые за другими поставщиками"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding CatalogItems}" Focusable="False" Margin="6,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Details}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Box" Background="Transparent" CornerRadius="7" Padding="8,8" BorderThickness="1" BorderBrush="Transparent">
                                                    <DockPanel>
                                                        <ui:Icon DockPanel.Dock="Right" Width="20" Height="20" Foreground="{StaticResource PrimaryBrush}" Data="{StaticResource IconPlus}"/>
                                                        <StackPanel Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Ничего не нашлось. Можно добавить новый продукт." TextAlignment="Center" Margin="20"
                               VerticalAlignment="Top" Visibility="{Binding HasCatalogItems, Converter={StaticResource BoolToCollapsed}, ConverterParameter=invert}"/>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                        <Button Style="{StaticResource GhostButton}" Content="Новый продукт" ui:Ui.Icon="{StaticResource IconPlus}" Command="{Binding NewProductCommand}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Сохранить -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Сохранить" MinWidth="130" ui:Ui.Icon="{StaticResource IconCheck}" Command="{Binding SaveCommand}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить и открыть в Word" Margin="10,0,0,0" ui:Ui.Icon="{StaticResource IconOpen}" Command="{Binding SaveAndOpenCommand}"/>
            </StackPanel>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
